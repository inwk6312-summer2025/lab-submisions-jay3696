[5989.214919, "o", "\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Get Help    \u001b(B\u001b[0;7m^O\u001b(B\u001b[m Write Out   \u001b(B\u001b[0;7m^W\u001b(B\u001b[m Where Is    \u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cut Text    \u001b(B\u001b[0;7m^J\u001b(B\u001b[m Justify     \u001b(B\u001b[0;7m^C\u001b(B\u001b[m Cur Pos     \u001b(B\u001b[0;7mM-U\u001b(B\u001b[m Undo\u001b[106G"]
[5989.215375, "o", "\u001b(B\u001b[0;7mM-A\u001b(B\u001b[m Mark Text\r\u001b[30d"]
[5989.215798, "o", "\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Exit\u001b[30;16H"]
[5989.216285, "o", "\u001b(B\u001b[0;7m^R\u001b(B\u001b[m Read File   \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Replace     \u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste Text  \u001b(B\u001b[0;7m^T\u001b(B\u001b[m To Spell    \u001b(B\u001b[0;7m^_\u001b(B\u001b[m Go To Line  \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\u001b[106G"]
[5989.216872, "o", "\u001b(B\u001b[0;7mM-6\u001b(B\u001b[m Copy Text\r\u001b[28d"]
[5989.217352, "o", "\u001b[2d"]
[5989.217808, "o", "\u001b[39;49m\u001b(B\u001b[m"]
[5989.218216, "o", "\u001b[?12l\u001b[?25h"]
[6003.688913, "o", "\u001b[?25l"]
[6003.702684, "o", "\u001b[28d"]
[6003.703117, "o", "\u001b[K"]
[6003.760048, "o", "\u001b[1;111H"]
[6003.760878, "o", "\u001b(B\u001b[0;7mModified"]
[6003.761411, "o", "\u001b(B\u001b[m"]
[6003.764093, "o", "\r\u001b[2d"]
[6003.764586, "o", "\u001b(B\u001b[0;1m\u001b[31m# import Jinja2 library and PyYAML\r\u001b[3d"]
[6003.765048, "o", "\u001b[36mfrom\u001b[39m\u001b(B\u001b[m jinja2 \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Environment, FileSystemLoader\r\u001b[4d"]
[6003.765488, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m yaml\r\u001b[5d"]
[6003.765951, "o", "\u001b(B\u001b[0;1m\u001b[31m# Declare template environment\r\u001b[6d"]
[6003.766435, "o", "\u001b[39m\u001b(B\u001b[mENV = Environment(loader=FileSystemLoader(\u001b(B\u001b[0;1m\u001b[32m'.'\u001b[39m\u001b(B\u001b[m))\r\u001b[7d"]
[6003.76691, "o", "\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m get_interface_speed\u001b[39m\u001b(B\u001b[m(interface_name):\r\u001b[8d"]
[6003.767347, "o", "\u001b(B\u001b[0;1m\u001b[32m\"\"\" get_interface_speed returns the default Mbps value for a given\r\u001b[9d"]
[6003.767792, "o", "network interface by looking for certain keywords in the name\r\u001b[10d"]
[6003.768216, "o", "\"\"\"\r\u001b[11d"]
[6003.768688, "o", "\u001b[36mif\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[32m'gigabit'\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m interface_name.lower():\r\u001b[12d"]
[6003.769213, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m 1000\r\u001b[13d"]
[6003.769617, "o", "\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[32m'fast'\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m interface_name.lower():\r\u001b[14d"]
[6003.770115, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m 100\r\u001b[15d"]
[6003.770599, "o", "\u001b(B\u001b[0;1m\u001b[31m# Filters are added to the ENV object after declaration. Note that we're\r\u001b[16d"]
[6003.771579, "o", "# actually passing in our \"get_interface_speed\" function and not running\r\u001b[17d"]
[6003.77202, "o", "# it--the template engine will execute this function when we call\r\u001b[18d"]
[6003.772416, "o", "# template.render()\r\u001b[19d"]
[6003.772941, "o", "\u001b[39m\u001b(B\u001b[mENV.filters[\u001b(B\u001b[0;1m\u001b[32m'get_interface_speed'\u001b[39m\u001b(B\u001b[m] = get_interface_speed\r\u001b[20d"]
[6003.773424, "o", "template = ENV.get_template(\u001b(B\u001b[0;1m\u001b[32m\"template-task8.j2\"\u001b[39m\u001b(B\u001b[m)\r\u001b[21d"]
[6003.773867, "o", "\u001b(B\u001b[0;1m\u001b[31m# We load our YAML file and pass it in to the template when rendering it.\r\u001b[22d"]
[6003.774429, "o", "\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m\"data-task7.yml\"\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m f:\r\u001b[23d"]
[6003.774959, "o", "interfaces = yaml.load(f, Loader=yaml.SafeLoader)\r\u001b[24d"]
[6003.775486, "o", "print(template.render(interface_list=interfaces))"]
