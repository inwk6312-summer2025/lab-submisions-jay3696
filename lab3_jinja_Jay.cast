[6316.539092, "o", "\u001b[H"]
[6316.539531, "o", "\u001b(B\u001b[0;7m  GNU nano 4.8                                       template-task8.j2                                                  \u001b[1;119H"]
[6316.539969, "o", "\u001b(B\u001b[m"]
[6316.540427, "o", "\r\u001b[29d"]
[6316.541005, "o", "\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Get Help    \u001b(B\u001b[0;7m^O\u001b(B\u001b[m Write Out   \u001b(B\u001b[0;7m^W\u001b(B\u001b[m Where Is    \u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cut Text    \u001b(B\u001b[0;7m^J\u001b(B\u001b[m Justify     \u001b(B\u001b[0;7m^C\u001b(B\u001b[m Cur Pos     \u001b(B\u001b[0;7mM-U\u001b(B\u001b[m Undo\u001b[106G"]
[6316.541511, "o", "\u001b(B\u001b[0;7mM-A\u001b(B\u001b[m Mark Text\r\u001b[30d"]
[6316.54197, "o", "\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Exit\u001b[30;16H"]
[6316.542489, "o", "\u001b(B\u001b[0;7m^R\u001b(B\u001b[m Read File   \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Replace     \u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste Text  \u001b(B\u001b[0;7m^T\u001b(B\u001b[m To Spell    \u001b(B\u001b[0;7m^_\u001b(B\u001b[m Go To Line  \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\u001b[106G"]
[6316.542936, "o", "\u001b(B\u001b[0;7mM-6\u001b(B\u001b[m Copy Text\r\u001b[28d"]
[6316.54359, "o", "\u001b[2d"]
[6316.544014, "o", "\u001b[39;49m\u001b(B\u001b[m{% for interface in interface_list %}\u001b[3;4H"]
[6316.544511, "o", "interface {{ interface.name }}\u001b[4;4H"]
[6316.544911, "o", "description {{ interface.desc|upper|reverse }}\r\u001b[5d"]
[6316.545324, "o", "{%- if interface.uplink %}\u001b[6;5H"]
[6316.54577, "o", "switchport mode trunk\r\u001b[7d"]
[6316.546168, "o", "{%- else %}\u001b[8;5H"]
[6316.546619, "o", "switchport access vlan {{ interface.vlan }}\u001b[9;5H"]
[6316.547019, "o", "switchport mode access\r\u001b[10d"]
[6316.547466, "o", "{%- endif %}\u001b[11;4H"]
[6316.547875, "o", "speed {{ interface.name|get_interface_speed }}\r\u001b[12d"]
[6316.548297, "o", "{% endfor %}\r\u001b[2d"]
