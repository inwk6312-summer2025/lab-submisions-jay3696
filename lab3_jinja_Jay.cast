[6230.039339, "o", "\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m get_interface_speed\u001b[39m\u001b(B\u001b[m(interface_name):\u001b[8;5H"]
[6230.039762, "o", "\u001b(B\u001b[0;1m\u001b[32m\"\"\" get_interface_speed returns the default Mbps value for a given\r\u001b[9d"]
[6230.040168, "o", "    network interface by looking for certain keywords in the name\r\u001b[10d"]
[6230.040547, "o", "    \"\"\"\u001b[11;5H"]
[6230.040915, "o", "\u001b[36mif\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[32m'gigabit'\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m interface_name.lower():\u001b[12;9H"]
[6230.041327, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m 1000\u001b[13;5H"]
[6230.041682, "o", "\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[32m'fast'\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m interface_name.lower():\u001b[14;9H"]
[6230.042092, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m 100\r\u001b[15d"]
[6230.042441, "o", "\u001b(B\u001b[0;1m\u001b[31m# Filters are added to the ENV object after declaration. Note that we're\r\u001b[16d"]
[6230.042865, "o", "# actually passing in our \"get_interface_speed\" function and not running\r\u001b[17d"]
[6230.043247, "o", "# it--the template engine will execute this function when we call\r\u001b[18d"]
[6230.043662, "o", "# template.render()\r\u001b[19d"]
[6230.044045, "o", "\u001b[39m\u001b(B\u001b[mENV.filters[\u001b(B\u001b[0;1m\u001b[32m'get_interface_speed'\u001b[39m\u001b(B\u001b[m] = get_interface_speed\r\u001b[20d"]
[6230.04448, "o", "template = ENV.get_template(\u001b(B\u001b[0;1m\u001b[32m\"template-task8.j2\"\u001b[39m\u001b(B\u001b[m)\r\u001b[21d"]
[6230.044874, "o", "\u001b(B\u001b[0;1m\u001b[31m# We load our YAML file and pass it in to the template when rendering it.\r\u001b[22d"]
[6230.045274, "o", "\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m\"data-task7.yml\"\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m f:\u001b[23;5H"]
[6230.045646, "o", "interfaces = yaml.load(f, Loader=yaml.SafeLoader)\u001b[24;5H"]
[6230.046042, "o", "print(template.render(interface_list=interfaces))\r\u001b[2d"]
[6230.046384, "o", "\u001b[?12l\u001b[?25h"]
[6285.358526, "o", "\u001b[?25l\u001b[28d"]
[6285.364656, "o", "\u001b[J\u001b[30d\u001b[?12l\u001b[?25h\u001b[30;1H\u001b[?1049l\u001b[23;0;0t\r\u001b[?1l\u001b>\u001b[?2004l"]
[6285.367859, "o", "(templates-lab) \u001b]0;student@6312vm-csr36: ~/templates-lab/src\u0007\u001b[01;32mstudent@6312vm-csr36\u001b[00m:\u001b[01;34m~/templates-lab/src\u001b[00m$ "]
