[3736.60629, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m jinja2 \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Environment, FileSystemLoader\r\u001b[3d"]
[3736.606712, "o", "\u001b(B\u001b[0;1m\u001b[31m# Set up the Jinja2 environment\r\u001b[4d"]
[3736.607118, "o", "\u001b[39m\u001b(B\u001b[mENV = Environment(loader=FileSystemLoader(\u001b(B\u001b[0;1m\u001b[32m'.'\u001b[39m\u001b(B\u001b[m))\r\u001b[5d"]
[3736.607591, "o", "\u001b(B\u001b[0;1m\u001b[31m# Load the template for Task 4\r\u001b[6d"]
[3736.608001, "o", "\u001b[39m\u001b(B\u001b[mtemplate = ENV.get_template(\u001b(B\u001b[0;1m\u001b[32m\"template-task4.j2\"\u001b[39m\u001b(B\u001b[m)\r\u001b[7d"]
[3736.608412, "o", "\u001b(B\u001b[0;1m\u001b[31m# Define the interface configuration object\r\u001b[8d"]
[3736.608862, "o", "\u001b[36mclass\u001b[39m\u001b(B\u001b[m NetworkInterface(object):\u001b[9;3H"]
[3736.609315, "o", "\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m __init__\u001b[39m\u001b(B\u001b[m(self, description, vlan):\u001b[10;7H"]
[3736.609796, "o", "self.description = description\u001b[11;7H"]
[3736.610212, "o", "self.vlan = vlan\r\u001b[12d"]
[3736.610613, "o", "\u001b(B\u001b[0;1m\u001b[31m# Create a single interface object\r\u001b[13d"]
[3736.611055, "o", "\u001b[39m\u001b(B\u001b[minterface_obj = NetworkInterface(\u001b(B\u001b[0;1m\u001b[32m\"Office Port\"\u001b[39m\u001b(B\u001b[m, 10)\r\u001b[14d"]
[3736.611456, "o", "\u001b(B\u001b[0;1m\u001b[31m# Render the template and print the result\r\u001b[15d"]
[3736.611865, "o", "\u001b[39m\u001b(B\u001b[mprint(template.render(interface=interface_obj))"]
